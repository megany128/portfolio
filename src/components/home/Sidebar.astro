<style>
  /* Desktop: static rail, tab and backdrop hidden.
     Sidebar gets a stacking context so ToC hover previews
     float above main content (which uses transforms/opacity).

     Default `overflow: visible` keeps hover previews escaping right.
     When viewport too short for content, `data-needs-scroll` toggles
     vertical scroll + horizontal clip and hides the previews (which
     would otherwise be clipped). JS sets the attribute. */
  .site-sidebar {
    position: sticky;
    top: 0;
    height: 100dvh;
    align-self: flex-start;
    z-index: 40;
    overflow: visible;
  }
  .site-sidebar[data-needs-scroll] {
    overflow-y: auto;
    overflow-x: clip;
    scrollbar-gutter: stable;
  }
  .site-sidebar[data-needs-scroll] :global(.toc-preview),
  .site-sidebar[data-needs-scroll] .sidebar-card-popover {
    display: none;
  }

  .sidebar-tab,
  .sidebar-backdrop,
  .sidebar-close {
    display: none;
  }

  /* Mini visitor card — compact pill that expands to a card popover on hover. */
  .sidebar-visitor-card-wrap {
    position: relative;
  }
  .sidebar-card-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px 4px 10px;
    border-radius: 20px;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    text-decoration: none;
    color: var(--color-ink-dim);
    background: var(--color-bg-neutral-2);
    transition:
      background var(--duration-fast) var(--ease-out-soft),
      color var(--duration-fast) var(--ease-out-soft);
  }
  .sidebar-card-pill:hover {
    color: var(--color-ink);
    background: #cfc7af;
  }
  .sidebar-card-pill__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  [data-color="pink"] .sidebar-card-pill__dot {
    background: var(--color-pink);
  }
  [data-color="teal"] .sidebar-card-pill__dot {
    background: var(--color-teal);
  }
  [data-color="green"] .sidebar-card-pill__dot {
    background: var(--color-green);
  }
  [data-color="orange"] .sidebar-card-pill__dot {
    background: var(--color-orange);
  }
  [data-color="neutral"] .sidebar-card-pill__dot {
    background: var(--color-fg-neutral);
  }

  /* Popover card — floats to the right on hover, like ToC previews. */
  .sidebar-card-popover {
    position: absolute;
    left: calc(100% + 16px);
    top: 50%;
    transform: translateY(-50%) translateX(-8px);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 220ms var(--ease-out-soft),
      transform 280ms var(--ease-out-soft);
    z-index: 50;
  }
  .sidebar-visitor-card-wrap:hover .sidebar-card-popover {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(-50%) translateX(0);
  }
  .sidebar-card-popover__link {
    display: flex;
    flex-direction: column;
    width: 200px;
    min-height: 130px;
    padding: 14px 16px 12px;
    border-radius: 14px;
    font-family: var(--font-mono);
    color: var(--color-ink-inverted);
    text-decoration: none;
    position: relative;
    overflow: hidden;
    box-shadow:
      0 18px 36px -16px rgba(36, 36, 36, 0.35),
      0 4px 10px -4px rgba(36, 36, 36, 0.2);
  }
  [data-color="pink"] .sidebar-card-popover__link {
    background: var(--color-pink);
  }
  [data-color="teal"] .sidebar-card-popover__link {
    background: var(--color-teal);
  }
  [data-color="green"] .sidebar-card-popover__link {
    background: var(--color-green);
  }
  [data-color="orange"] .sidebar-card-popover__link {
    background: var(--color-orange);
  }
  [data-color="neutral"] .sidebar-card-popover__link {
    background: var(--color-bg-neutral-2);
    color: var(--color-ink);
  }
  .sidebar-card-popover__link:hover {
    transform: scale(1.03) rotate(-0.5deg);
    transition: transform var(--duration-fast) var(--ease-out-soft);
  }
  .sidebar-card__art {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translateY(-50%);
    font-size: 5px;
    line-height: 1.08;
    opacity: 0.35;
    pointer-events: none;
    white-space: pre;
    margin: 0;
  }
  .sidebar-card__title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 12px;
    line-height: 1;
    text-transform: none;
  }
  .sidebar-card__fields {
    margin-top: 6px;
  }
  .sidebar-card__fields dt {
    font-size: 7px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.65;
    line-height: 1;
  }
  .sidebar-card__fields dd {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1;
    margin: 2px 0 0;
  }
  .sidebar-card__footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-top: auto;
    position: relative;
  }
  .sidebar-card__number {
    font-size: 7px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.65;
    line-height: 1;
  }
  .sidebar-card__sig {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    font-size: 10px;
    line-height: 1;
    flex: 1;
    margin-left: 14px;
  }
  .sidebar-card__sigline {
    display: block;
    flex: 1;
    border-bottom: 1px solid var(--color-ink-inverted);
    margin-bottom: 1px;
  }
  [data-color="neutral"] .sidebar-card__sigline {
    border-color: var(--color-ink);
  }
  .sidebar-card__signature {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 80%;
    height: 80%;
    object-fit: contain;
    object-position: center bottom;
    pointer-events: none;
    mix-blend-mode: normal;
  }
  [data-color]:not([data-color="neutral"]) .sidebar-card__signature {
    filter: brightness(0) invert(1);
  }
  @media (max-width: 1023px) {
    .sidebar-card-popover {
      display: none;
    }
  }

  /* Flash highlight applied to the gallery card we just scrolled to.
     Uses a global selector so it can target [data-mini-card-wrap] in Grid. */
  :global(.mini-card-wrap.sidebar-card-flash) {
    animation: sidebar-card-flash 1.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @keyframes sidebar-card-flash {
    0% {
      filter: drop-shadow(0 0 0 rgba(255, 255, 255, 0));
      transform: scale(1);
    }
    20% {
      filter: drop-shadow(0 0 18px rgba(255, 255, 255, 0.7))
        drop-shadow(0 14px 22px rgba(0, 0, 0, 0.22));
      transform: scale(1.04);
    }
    100% {
      filter: drop-shadow(0 0 0 rgba(255, 255, 255, 0));
      transform: scale(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.mini-card-wrap.sidebar-card-flash) {
      animation: none;
    }
  }

  @media (max-width: 1023px) {
    .site-sidebar {
      position: fixed;
      inset: 0 auto 0 0;
      z-index: 50;
      max-width: 85vw;
      transform: translateX(-100%);
      transition: transform var(--duration-base) var(--ease-out-soft);
      box-shadow: 2px 0 28px -8px rgba(36, 36, 36, 0.15);
      overflow-y: auto;
    }
    .site-sidebar[data-open] {
      transform: translateX(0);
    }

    .sidebar-backdrop {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 45;
      background: rgba(36, 36, 36, 0.35);
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--duration-base) var(--ease-out-soft);
    }
    .sidebar-backdrop[data-open] {
      opacity: 1;
      pointer-events: auto;
    }

    .sidebar-tab {
      display: flex;
      align-items: center;
      gap: 4px;
      position: fixed;
      top: 50%;
      left: 0;
      z-index: 40;
      padding: 14px 8px 14px 6px;
      background: var(--color-bg-neutral-2);
      color: var(--color-ink);
      border: 0;
      border-top-right-radius: 12px;
      border-bottom-right-radius: 12px;
      box-shadow: 2px 0 12px -4px rgba(36, 36, 36, 0.15);
      cursor: pointer;
      transform: translateY(-50%);
      transition:
        transform var(--duration-fast) var(--ease-out-soft),
        background var(--duration-fast) var(--ease-out-soft);
    }
    .sidebar-tab:hover {
      transform: translate(3px, -50%);
      background: #cfc7af;
    }
    .sidebar-tab:focus-visible {
      outline: 2px solid var(--color-ink);
