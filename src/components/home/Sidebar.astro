    }
    .sidebar-tab-dots {
      display: inline-flex;
      flex-direction: column;
      gap: 3px;
    }
    .sidebar-tab-dots span {
      display: block;
      width: 3px;
      height: 3px;
      border-radius: 9999px;
      background: var(--color-ink-dim);
    }
    .sidebar-tab-arrow {
      font-family: var(--font-mono);
      font-size: 16px;
      line-height: 1;
      color: var(--color-ink);
