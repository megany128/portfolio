      justify-content: center;
      position: absolute;
      top: 14px;
      right: 14px;
      width: 32px;
      height: 32px;
      border: 0;
      border-radius: 9999px;
      background: transparent;
      color: var(--color-ink-dim);
      font-size: 22px;
      line-height: 1;
      cursor: pointer;
      transition:
        background var(--duration-fast) var(--ease-out-soft),
        color var(--duration-fast) var(--ease-out-soft);
    }
    .sidebar-close:hover {
      background: var(--color-bg-neutral-2);
      color: var(--color-ink);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-sidebar,
    .sidebar-backdrop,
    .sidebar-tab {
      transition: none;
    }
  }

  /* Logo spin + sparks on tap. */
  .sidebar-logo-link {
    overflow: visible;
  }
  .sidebar-logo-spin {
    display: inline-block;
  }
  .sidebar-logo-sparks .spark {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 4px;
    height: 4px;
    border-radius: 9999px;
    background: var(--spark-color, var(--color-pink));
    box-shadow: 0 0 6px var(--spark-color, var(--color-pink));
    transform: translate(-50%, -50%);
    opacity: 0;
    animation: sidebar-logo-spark 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  @keyframes sidebar-logo-spark {
    0% {
      opacity: 1;
      transform: translate(-50%, -50%) translate(0, 0) scale(0.6);
    }
    100% {
      opacity: 0;
      transform: translate(-50%, -50%) translate(var(--spark-dx, 0px), var(--spark-dy, 0px))
        scale(0.9);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sidebar-logo-sparks .spark {
      animation: none;
      opacity: 0;
    }
  }

  /* Status pulse — matching the welcome/onboarding scene's green dot.
     Inlined with the text so it sits on the first line's cap-height even
     when "ALL SYSTEMS OPERATIONAL" wraps to two lines. Margin-right gives
     the old gap-1.5 spacing without relying on flex. Translate nudges the
     dot up a touch to sit at the optical center of the uppercase glyphs. */
  .sidebar-status-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: var(--color-green-1);
    margin-right: 6px;
    transform: translateY(-2px);
    animation: sidebar-status-pulse 2.4s ease-in-out infinite;
  }
  @keyframes sidebar-status-pulse {
    0%,
    100% {
      opacity: 0.9;
      box-shadow: 0 0 0 0 rgba(125, 181, 146, 0.55);
    }
    50% {
      opacity: 0.5;
      box-shadow: 0 0 0 4px rgba(125, 181, 146, 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sidebar-status-dot {
      animation: none;
    }
  }
</style>

<script>
  /*
    Wire the sidebar on every ClientRouter swap. We re-query the elements each
    time so references stay valid, and guard each wiring with `data-wired` so
    we don't stack listeners.
  */
  function wireSidebar() {
    const sidebar = document.querySelector<HTMLElement>("[data-sidebar]");
    const toggle = document.querySelector<HTMLElement>("[data-sidebar-toggle]");
    const backdrop = document.querySelector<HTMLElement>("[data-sidebar-backdrop]");
    const closeBtn = document.querySelector<HTMLElement>("[data-sidebar-close]");

    function openSidebar() {
      sidebar?.setAttribute("data-open", "");
      backdrop?.setAttribute("data-open", "");
      toggle?.setAttribute("aria-expanded", "true");
    }
    function closeSidebar() {
      sidebar?.removeAttribute("data-open");
      backdrop?.removeAttribute("data-open");
      toggle?.setAttribute("aria-expanded", "false");
    }

    if (toggle && toggle.dataset.wired !== "1") {
      toggle.dataset.wired = "1";
      toggle.addEventListener("click", openSidebar);
    }
    if (closeBtn && closeBtn.dataset.wired !== "1") {
      closeBtn.dataset.wired = "1";
      closeBtn.addEventListener("click", closeSidebar);
    }
    if (backdrop && backdrop.dataset.wired !== "1") {
      backdrop.dataset.wired = "1";
      backdrop.addEventListener("click", closeSidebar);
    }

    // Toggle `data-needs-scroll` when sidebar content exceeds viewport height.
    // Keeps hover previews unclipped on tall screens; switches to scrollable
    // mode + hides previews on short screens (where they'd be clipped anyway).
    if (sidebar && sidebar.dataset.scrollWired !== "1") {
      sidebar.dataset.scrollWired = "1";
      let pending = 0;
      const updateNeedsScroll = () => {
        if (pending) return;
        pending = requestAnimationFrame(() => {
          pending = 0;
          // Force scroll mode briefly to measure true content height. With
          // overflow:visible + `mt-auto` on status, auto margins can collapse
          // (overlap) so scrollHeight==clientHeight even when content doesn't
          // fit. Switching to scroll mode reveals the real content size.
          sidebar.setAttribute("data-needs-scroll", "");
          const overflows = sidebar.scrollHeight > sidebar.clientHeight + 1;
          if (!overflows) sidebar.removeAttribute("data-needs-scroll");
        });
      };
      updateNeedsScroll();
      if ("ResizeObserver" in window) {
        const ro = new ResizeObserver(() => updateNeedsScroll());
        ro.observe(sidebar);
        Array.from(sidebar.children).forEach((c) => ro.observe(c as Element));
      }
      window.addEventListener("resize", updateNeedsScroll);
    }
  }

  // Document-level listeners are stable across ClientRouter swaps, so attach
  // them exactly once per document.
  if (!(window as any).__sidebarGlobalsWired) {
    (window as any).__sidebarGlobalsWired = true;
    document.addEventListener("keydown", (event) => {
      const sidebar = document.querySelector<HTMLElement>("[data-sidebar]");
      if (event.key === "Escape" && sidebar?.hasAttribute("data-open")) {
        sidebar.removeAttribute("data-open");
        document.querySelector("[data-sidebar-backdrop]")?.removeAttribute("data-open");
        document.querySelector("[data-sidebar-toggle]")?.setAttribute("aria-expanded", "false");
      }
    });
    const desktopQuery = window.matchMedia("(min-width: 1024px)");
    desktopQuery.addEventListener("change", (event) => {
      if (event.matches) {
        document.querySelector("[data-sidebar]")?.removeAttribute("data-open");
        document.querySelector("[data-sidebar-backdrop]")?.removeAttribute("data-open");
      }
    });

    // Live clock — queries the current node each tick so SPA swaps keep it ticking.
    function tickSidebarClock() {
      const el = document.querySelector<HTMLElement>("[data-sidebar-clock]");
      if (!el) return;
      const now = new Date();
      const h12 = ((now.getHours() + 11) % 12) + 1;
      const mm = String(now.getMinutes()).padStart(2, "0");
      const ss = String(now.getSeconds()).padStart(2, "0");
      const ampm = now.getHours() >= 12 ? "PM" : "AM";
      el.textContent = `${h12}:${mm}:${ss} ${ampm}`;
    }
    tickSidebarClock();
    setInterval(tickSidebarClock, 1000);
  }

  /*
    Logo tap — spin the mark + emit a small burst of colored sparks. The
    click stays a link navigation; we just layer the animation on top.
  */
  const SPARK_COLORS = [
    "var(--color-pink)",
    "var(--color-teal)",
    "var(--color-orange)",
    "var(--color-green-1)",
  ];
  function wireLogo() {
    document.querySelectorAll<HTMLElement>("[data-logo-link]:not([data-wired])").forEach((link) => {
      link.dataset.wired = "1";
      const sparks = link.querySelector<HTMLElement>("[data-logo-sparks]");
      link.addEventListener("click", () => {
        if (sparks) {
          const reduced = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
          if (reduced) return;
          const count = 10;
          for (let i = 0; i < count; i++) {
            const angle = (i / count) * Math.PI * 2 + Math.random() * 0.4;
            const dist = 24 + Math.random() * 16;
            const el = document.createElement("span");
            el.className = "spark";
            el.style.setProperty("--spark-dx", `${Math.cos(angle) * dist}px`);
            el.style.setProperty("--spark-dy", `${Math.sin(angle) * dist}px`);
            el.style.setProperty("--spark-color", SPARK_COLORS[i % SPARK_COLORS.length]);
            sparks.appendChild(el);
            window.setTimeout(() => el.remove(), 720);
          }
        }
      });
    });
  }

  /*
    Visitor-card pill — when on /visitor-gallery, intercept the click and
    scroll to the user's own card in the grid instead of re-navigating. The
    grid exposes the visitor id via [data-gallery-grid][data-you-id], set
    server-side and patched by the localStorage fallback if needed.
  */
  function wireSidebarCard() {
    document
      .querySelectorAll<HTMLAnchorElement>("[data-sidebar-card]:not([data-wired])")
      .forEach((pill) => {
        pill.dataset.wired = "1";
        pill.addEventListener("click", (e) => {
          // Off-gallery click: leave nav alone, just flag the intent so the
          // gallery page scrolls to the user's card after it mounts.
          if (location.pathname !== "/visitor-gallery") {
            try {
              sessionStorage.setItem("gallery:scroll-to-you", "1");
            } catch {}
            return;
          }
          const grid = document.querySelector<HTMLElement>("[data-gallery-grid]");
          const youId = grid?.dataset.youId;
          if (!grid || !youId) return;
          const card = grid.querySelector<HTMLElement>(`[data-mini-card-wrap][data-id="${youId}"]`);
          if (!card) return;
          e.preventDefault();
          const reduced = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
          const flash = () => {
            card.classList.add("sidebar-card-flash");
            window.setTimeout(() => card.classList.remove("sidebar-card-flash"), 1400);
          };
          card.scrollIntoView({ behavior: reduced ? "auto" : "smooth", block: "center" });
          // Wait for scroll to settle before flashing — pulse plays mid-scroll
          // otherwise and the user can't see it.
          if (reduced) {
            flash();
          } else {
            let settled = false;
            const fire = () => {
              if (!settled) {
                settled = true;
                flash();
              }
            };
            const hasScrollEnd = "onscrollend" in window;
            if (hasScrollEnd) {
              window.addEventListener("scrollend", fire, { once: true });
              window.setTimeout(fire, 1200);
            } else {
              let lastY = window.scrollY;
              let stable = 0;
              const tick = () => {
                if (settled) return;
                const y = window.scrollY;
                if (Math.abs(y - lastY) < 0.5) {
                  if (++stable >= 4) return fire();
                } else {
                  stable = 0;
                  lastY = y;
                }
                requestAnimationFrame(tick);
              };
              requestAnimationFrame(tick);
              window.setTimeout(fire, 1200);
            }
          }
          // Close the mobile sidebar so the card isn't covered.
          document.querySelector<HTMLElement>("[data-sidebar]")?.removeAttribute("data-open");
          document
            .querySelector<HTMLElement>("[data-sidebar-backdrop]")
            ?.removeAttribute("data-open");
        });
      });
  }

  function init() {
    wireSidebar();
    wireLogo();
    wireSidebarCard();
  }
  init();
  document.addEventListener("astro:page-load", init);
</script>
