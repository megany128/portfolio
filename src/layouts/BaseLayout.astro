---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import SitePet from "../components/site/SitePet.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  bodyClass?: string;
  darkHtml?: boolean;
  showPet?: boolean;
  /** Override the canonical URL — pass a path (e.g. "/home") when the
   *  current page should consolidate SEO signals onto a different URL. */
  canonical?: string;
}

const {
  title = "Megan Yap",
  description = "Portfolio of Megan Yap.",
  image = "/og.png",
  bodyClass = "",
  darkHtml = false,
  showPet = true,
  canonical,
} = Astro.props;

const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Megan Yap" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/png" href="/portfolio-logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Source+Code+Pro:wght@300;400;500;600&display=swap"
    />
    <title>{title}</title>
    <ClientRouter />
    {darkHtml && <style set:html="html { background: var(--color-ink) !important; }" />}

    <style is:global>
      /*
        View Transitions — disable all default animations so page swaps
        are instant. Named groups (wallet-veil) can opt back in.
      */
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation: none !important;
      }

      /* Wallet finale: the cream overlay on onboarding shares `wallet-veil`
         with a matching veil on home, so the cream fades out while home's
         content slides in under it. */
      ::view-transition-old(wallet-veil),
      ::view-transition-new(wallet-veil) {
        animation-duration: 720ms;
        animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
      }

      /* Sunrise flow — already covered by instant root, but keep for safety. */
      html[data-sunrise-play]::view-transition-old(root),
      html[data-sunrise-play]::view-transition-new(root) {
        animation: none !important;
      }

      /* Edit card: card flies from gallery position to edit screen center. */
      ::view-transition-old(edit-card),
      ::view-transition-new(edit-card) {
        animation-duration: 480ms;
        animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
      }

      /* Named groups (sidebar, footer) — no animation either. */
      ::view-transition-old(sidebar),
      ::view-transition-new(sidebar),
      ::view-transition-old(footer),
      ::view-transition-new(footer) {
        animation: none !important;
      }
    </style>
  </head>
  <body class={bodyClass}>
    <slot />
    {showPet && <SitePet />}

    <script>
      /*
        Gallery navigation skeleton. Default View Transition animations are
        disabled (instant swap), so while ClientRouter fetches the next page in
        the background there is zero visual feedback. /visitor-gallery is the
        one heavy route, so when a nav toward it begins we drop a shape-correct
        skeleton (sidebar block + a responsive grid of card placeholders) the
        instant the click lands, and remove it once the real page swaps in.

        Wired once per document: ClientRouter swaps the <body> but keeps the
        document and module scope, so a one-time bind on `document` survives
        every navigation. The overlay lives on <html> for the same reason.
      */
      (function () {
        const w = window as unknown as { __gallerySkeletonWired?: boolean };
        if (w.__gallerySkeletonWired) return;
        w.__gallerySkeletonWired = true;

        const GALLERY_PATH = "/visitor-gallery";
        const CARD_COUNT = 9;

        const style = document.createElement("style");
        style.textContent = `
          #gallery-skeleton {
            position: fixed; inset: 0; z-index: 9998;
            background: var(--color-bg); display: flex; align-items: stretch;
            animation: gs-fade 140ms ease-out;
          }
          @keyframes gs-fade { from { opacity: 0 } to { opacity: 1 } }
          #gallery-skeleton .gs-sidebar {
            width: 303px; flex-shrink: 0; background: var(--color-bg-light);
          }
          @media (max-width: 767px) { #gallery-skeleton .gs-sidebar { display: none } }
          #gallery-skeleton .gs-main {
            flex: 1; min-width: 0; padding: 1rem;
            display: flex; flex-direction: column; gap: 1.5rem;
          }
          @media (min-width: 640px) { #gallery-skeleton .gs-main { padding: 1.5rem } }
          @media (min-width: 768px) { #gallery-skeleton .gs-main { padding: 2.5rem } }
          #gallery-skeleton .gs-title {
            font-family: var(--font-display); font-weight: 300;
            font-size: 36px; line-height: 1; color: var(--color-ink);
          }
          @media (max-width: 640px) { #gallery-skeleton .gs-title { font-size: 28px } }
          #gallery-skeleton .gs-grid {
            display: grid; grid-template-columns: 1fr; gap: 1.5rem 1rem;
          }
          @media (min-width: 640px) { #gallery-skeleton .gs-grid { grid-template-columns: 1fr 1fr } }
          @media (min-width: 1024px) { #gallery-skeleton .gs-grid { grid-template-columns: 1fr 1fr 1fr } }
          #gallery-skeleton .gs-card {
            aspect-ratio: 388 / 252; border-radius: 24px;
            background: color-mix(in oklab, var(--color-ink) 7%, var(--color-bg-light));
            animation: gs-pulse 1.4s ease-in-out infinite;
          }
          @keyframes gs-pulse { 0%, 100% { opacity: 0.5 } 50% { opacity: 0.9 } }
          @media (prefers-reduced-motion: reduce) {
            #gallery-skeleton { animation: none }
            #gallery-skeleton .gs-card { animation: none; opacity: 0.65 }
          }
        `;

        function build(): HTMLElement {
          const root = document.createElement("div");
          root.id = "gallery-skeleton";
          root.setAttribute("aria-hidden", "true");
          const cards = Array.from({ length: CARD_COUNT })
            .map(() => '<div class="gs-card"></div>')
            .join("");
          root.innerHTML =
            '<div class="gs-sidebar"></div>' +
            '<div class="gs-main">' +
            '<div class="gs-title">Visitor Gallery</div>' +
            `<div class="gs-grid">${cards}</div>` +
            "</div>";
          return root;
        }

        function show(event: Event & { to?: URL; from?: URL }) {
          const to = event.to;
          if (!to || to.pathname !== GALLERY_PATH) return;
          // Already on the gallery (e.g. shuffle / scroll-to-you) — no skeleton.
          if (event.from && event.from.pathname === GALLERY_PATH) return;
          if (document.getElementById("gallery-skeleton")) return;
          if (!style.isConnected) document.head.appendChild(style);
          document.documentElement.appendChild(build());
        }

        function hide() {
          document.getElementById("gallery-skeleton")?.remove();
        }

        document.addEventListener("astro:before-preparation", show as EventListener);
        // page-load fires after the swap on every ClientRouter navigation; also
        // covers the case where the destination wasn't the gallery (no-op hide).
        document.addEventListener("astro:page-load", hide);
      })();
    </script>
  </body>
</html>
